{
  "expo": {
    "name": "NCSpectra",
    "slug": "ncspectra-tactical-field",
    "version": "1.0.0",
    "scheme": "ncspectra",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050B14"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.isnu4837.ncspectratacticalfield"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bd39699e-d416-43f0-8419-031ba1ed6c87"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050B14",
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#050B14"
          },
          "android": {
            "image": "./assets/icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#050B14"
          }
        }
      ],
      "expo-sqlite"
    ]
  }
}
